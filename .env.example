# Copy to .env and fill in real values. Never commit .env.

DATABASE_URL="postgresql://stayfinder:stayfinder@localhost:5434/stayfinder"

# Stripe (test mode keys while developing) -- dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=

# Mercado Pago (test/sandbox credentials, "TEST-..." prefix) --
# mercadopago.com.mx/developers/panel/app -- server-only, never prefix this
# NEXT_PUBLIC_ or read it from a "use client" component.
MERCADOPAGO_ACCESS_TOKEN=

# Used to build Stripe Checkout's success_url/cancel_url and Mercado Pago's
# back_urls -- no trailing slash.
NEXT_PUBLIC_APP_URL=http://localhost:3000
